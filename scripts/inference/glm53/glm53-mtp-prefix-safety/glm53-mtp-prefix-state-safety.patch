+    if num_actual_tokens < 0 or expected_non_spec_tokens < 0:
+        raise ValueError("mixed GDN token counts must be non-negative")
+    if torch.any(query_lens < 0).item():
+        raise ValueError("mixed GDN query lengths must be non-negative")
+
