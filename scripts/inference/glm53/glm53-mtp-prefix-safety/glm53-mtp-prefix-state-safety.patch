+    if token_count != num_actual_tokens:
+        raise ValueError(
+            "mixed GDN query lengths do not cover the actual token rows: "
+            f"query_tokens={token_count}, actual_tokens={num_actual_tokens}"
+        )
+
+    token_is_spec = torch.repeat_interleave(spec_sequence_masks, query_lens)
+    non_spec_count = int((~token_is_spec).sum().item())
+    if non_spec_count != expected_non_spec_tokens:
