+    """Build a complete, in-range mixed GDN token partition on the CPU."""
+    if spec_sequence_masks.device.type != "cpu" or query_lens.device.type != "cpu":
+        raise ValueError("mixed GDN token partition inputs must be CPU tensors")
+    if spec_sequence_masks.ndim != 1 or query_lens.ndim != 1:
+        raise ValueError("mixed GDN token partition inputs must be one-dimensional")
+    if spec_sequence_masks.numel() != query_lens.numel():
