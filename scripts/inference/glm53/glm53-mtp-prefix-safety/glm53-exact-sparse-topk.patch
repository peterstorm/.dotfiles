+def _exact_sparse_attn_topk(
+    logits: torch.Tensor,
+    seq_lens: torch.Tensor,
+    topk_indices: torch.Tensor,
+    topk_tokens: int,
+) -> None:
+    """Select exact in-range sparse-attention candidates into caller-owned storage.
+
+    ``persistent_topk`` silently truncates crowded histogram bins (vLLM #51782)
+    and its atomic append order makes the wrong candidate set non-deterministic.
+    Masking by each row's authoritative sequence length also prevents stale logits
+    outside the live range from entering the exact ``torch.topk`` selection.
+    """
+    if logits.ndim != 2:
+        raise RuntimeError(f"sparse-attention logits must be rank 2, got {logits.ndim}")
+    row_lens = seq_lens.reshape(-1)
+    if row_lens.numel() != logits.shape[0]:
+        raise RuntimeError(
+            "sparse-attention sequence lengths must contain one entry per logits row, "
+            f"got {row_lens.numel()} lengths for {logits.shape[0]} rows"
+        )
+    if topk_indices.ndim != 2 or topk_indices.shape[0] != logits.shape[0]:
+        raise RuntimeError(
+            "sparse-attention top-k output must be rank 2 with one row per logits row"
+        )
+    if topk_tokens <= 0 or topk_tokens > topk_indices.shape[1]:
+        raise RuntimeError(
+            f"invalid sparse-attention top-k width {topk_tokens} for output shape "
+            f"{tuple(topk_indices.shape)}"
+        )
+
+    num_columns = logits.shape[1]
+    selected_width = min(topk_tokens, num_columns)
+    lengths = row_lens.to(device=logits.device, dtype=torch.int64).clamp(
+        min=0, max=num_columns
+    )
+    columns = torch.arange(num_columns, dtype=torch.int64, device=logits.device)
+    score_bits = logits.contiguous().view(torch.int32).to(torch.int64) & 0xFFFFFFFF
+    ordered_scores = torch.where(
+        score_bits & 0x80000000 != 0,
+        ~score_bits & 0xFFFFFFFF,
+        score_bits ^ 0x80000000,
+    )
+    score_keys = ordered_scores - 0x80000000
+    deterministic_keys = (score_keys << 32) | (0xFFFFFFFF - columns.unsqueeze(0))
+    deterministic_keys.masked_fill_(
+        columns.unsqueeze(0) >= lengths.unsqueeze(1), torch.iinfo(torch.int64).min
+    )
+    selected = torch.topk(
+        deterministic_keys, selected_width, dim=1, sorted=True
+    ).indices
+
+    ranks = torch.arange(selected_width, device=logits.device)
+    selected.masked_fill_(ranks.unsqueeze(0) >= lengths.unsqueeze(1), -1)
+    topk_indices.fill_(-1)
+    topk_indices[:, :selected_width].copy_(selected.to(topk_indices.dtype))
 
 
