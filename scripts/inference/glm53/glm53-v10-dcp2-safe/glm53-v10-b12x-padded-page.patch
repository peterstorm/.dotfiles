+def _require_packed_paged_kv_cache(
+    kv_cache: torch.Tensor,
+    block_size: int,
+    record_bytes: int,
+    feature: str,
+) -> torch.Tensor:
+    """Return a B12X-safe packed-record view or fail before kernel launch."""
+    expected_tail = (int(block_size), int(record_bytes))
+    strides = tuple(kv_cache.stride()) if kv_cache.ndim == 3 else ()
+    minimum_page_stride = int(block_size) * int(record_bytes)
+    available_bytes = (
+        kv_cache.untyped_storage().nbytes() - int(kv_cache.storage_offset())
+        if kv_cache.dtype == torch.uint8
+        else 0
+    )
+    required_bytes = (
+        (int(kv_cache.shape[0]) - 1) * strides[0] + minimum_page_stride
+        if kv_cache.ndim == 3 and int(kv_cache.shape[0]) > 0
+        else 0
+    )
+    if (
+        kv_cache.dtype != torch.uint8
+        or kv_cache.ndim != 3
+        or int(kv_cache.shape[0]) <= 0
+        or tuple(kv_cache.shape[1:]) != expected_tail
+        or strides[2] != 1
+        or strides[1] != int(record_bytes)
+        or strides[0] < minimum_page_stride
+        or strides[0] % 16 != 0
+        or kv_cache.data_ptr() % 16 != 0
+        or required_bytes > available_bytes
+    ):
+        raise ValueError(
+            f"{feature} requires packed {record_bytes}-byte records in "
+            f"({block_size},{record_bytes}) pages with a 16-byte-aligned "
+            f"page stride >= {minimum_page_stride}; got "
+            f"shape={tuple(kv_cache.shape)}, stride={strides}, "
+            f"dtype={kv_cache.dtype}, available_bytes={available_bytes}"
+        )
+    return kv_cache
+
+
 def _cdiv(x: int, y: int) -> int:
     return (int(x) + int(y) - 1) // int(y)
 
