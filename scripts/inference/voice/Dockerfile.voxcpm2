FROM pytorch/pytorch:2.9.1-cuda13.0-cudnn9-runtime@sha256:60f22fb80755fd0b470fb47928dbd55816aa9f847edd95cf43c93253507a9ddf

ARG VOXCPM_SOURCE_REV=f5a1c6a6b901bc732e20f0d59a369f6829ad717a

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git \
      libsndfile1 \
      libsox-fmt-all \
      sox \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/OpenBMB/VoxCPM.git /opt/voxcpm \
    && git -C /opt/voxcpm checkout --detach "$VOXCPM_SOURCE_REV" \
    && test "$(git -C /opt/voxcpm rev-parse HEAD)" = "$VOXCPM_SOURCE_REV" \
    && python -m pip install --no-cache-dir /opt/voxcpm \
    && python -m pip check \
    && rm -rf /opt/voxcpm/.git

RUN python - <<'PY'
from voxcpm import VoxCPM
assert VoxCPM is not None
PY

LABEL org.opencontainers.image.title="VoxCPM2 offline voice identity audition runtime" \
      org.opencontainers.image.source="https://github.com/OpenBMB/VoxCPM" \
      org.opencontainers.image.revision="f5a1c6a6b901bc732e20f0d59a369f6829ad717a" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /work
