diff -ruN a/serve/test_keepalive.py b/serve/test_keepalive.py
--- a/serve/test_keepalive.py	1970-01-01 01:00:00.000000000 +0100
+++ b/serve/test_keepalive.py	2026-11-02 20:13:23.460918285 +0100
@@ -0,0 +1,76 @@
+"""serve/test_keepalive.py - a streamed answer keeps the connection alive while tokens flow with nothing to send.
+
+A tool call's parameter that is held back until it is complete (here an object, which goes out whole) can take
+minutes to write; a client's read timeout (Node's fetch: 300 s without a byte) would cut the request.  The stream
+carries keep-alive comments through such a stretch, and the call arrives whole after it.
+
+    python -m unittest serve.test_keepalive -v
+"""
+from __future__ import annotations
+
+import json
+import sys
+import time
+import unittest
+import urllib.request
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import serve.server as srv  # noqa: E402
+from serve.frontend import ChatTemplate  # noqa: E402
+from serve.server import ByteTokenizer, MockEngine, Service, serve  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+TOOL = {"type": "function", "function": {"name": "save", "parameters": {
+    "type": "object", "properties": {"data": {"type": "object"}}}}}
+VALUE = {"text": "a" * 600}
+CALL = ("<tool_call>save\n<arg_key>data</arg_key>\n<arg_value>" + json.dumps(VALUE) + "</arg_value>\n</tool_call>")
+
+
+class Paced(MockEngine):
+    """The mock engine's tokens, 2 ms apart: the held-back value takes over a second to write."""
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        for t in super().generate(ids, max_new, sampling, cancel, embeddings):
+            time.sleep(0.002)
+            yield t
+
+
+class KeepAliveWhileHeld(unittest.TestCase):
+    def setUp(self):
+        self.quiet = srv.QUIET_PING_S
+        srv.QUIET_PING_S = 0.2
+
+    def tearDown(self):
+        srv.QUIET_PING_S = self.quiet
+
+    def stream(self) -> str:
+        tok = ByteTokenizer()
+        svc = Service(Paced(tok, "</think>\n\n" + CALL, max_context=8192), tok,
+                      ChatTemplate(ROOT / "serve/chat_template.jinja"))
+        httpd = serve(svc, port=0)
+        base = f"http://127.0.0.1:{httpd.server_address[1]}"
+        body = {"model": "m", "stream": True, "max_tokens": 4000, "tools": [TOOL],
+                "messages": [{"role": "user", "content": "save it"}]}
+        try:
+            req = urllib.request.Request(base + "/v1/chat/completions", data=json.dumps(body).encode(),
+                                         headers={"Content-Type": "application/json"})
+            with urllib.request.urlopen(req, timeout=60) as r:
+                return r.read().decode()
+        finally:
+            httpd.shutdown()
+            httpd.server_close()
+
+    def test_keep_alives_while_a_value_is_held_and_the_call_arrives_whole(self):
+        text = self.stream()
+        # the value takes ~1.2 s at 2 ms a token: several 0.2 s stretches with nothing to send
+        self.assertGreaterEqual(text.count(": keep-alive"), 3)
+        chunks = [json.loads(line[len("data: "):]) for line in text.splitlines()
+                  if line.startswith("data: ") and line != "data: [DONE]"]
+        args = "".join(tc["function"].get("arguments") or "" for c in chunks
+                       for tc in c["choices"][0]["delta"].get("tool_calls") or [])
+        self.assertEqual(json.loads(args), {"data": VALUE})
+
+
+if __name__ == "__main__":
+    unittest.main()
