index 0000000..9a29671
--- /dev/null
+++ b/vllm/models/deepseek_v4/multimodal.py
@@ -0,0 +1,389 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Multimodal processor and non-invasive wrapper for DeepSeek V4 Vision."""
+
+from collections.abc import Iterable, Mapping, Sequence
+from typing import Any
+
+import torch
+import torch.nn as nn
+from transformers import BatchFeature
+
+from vllm.config import VllmConfig
+from vllm.config.multimodal import BaseDummyOptions
+from vllm.inputs import MultiModalDataDict
+from vllm.model_executor.models.interfaces import (
+    MultiModalEmbeddings,
+    SupportsMultiModal,
+)
+from vllm.model_executor.models.utils import _merge_multimodal_embeddings
+from vllm.multimodal import MULTIMODAL_REGISTRY
+from vllm.multimodal.inputs import MultiModalFieldConfig, MultiModalKwargsItems
+from vllm.multimodal.parse import MultiModalDataItems
+from vllm.multimodal.processing import (
+    BaseDummyInputsBuilder,
+    BaseMultiModalProcessor,
+    BaseProcessingInfo,
+    InputProcessingContext,
+    PromptReplacement,
+    PromptUpdate,
+    PromptUpdateDetails,
+)
+from vllm.multimodal.processing.processor import ProcessorInputs, TimingContext
+from vllm.transformers_utils.configs.deepseek_v4 import DeepseekV4Config
+
+from .image_processing import (
+    IMAGE,
+    IMAGE_END,
+    IMAGE_PLACEHOLDER,
+    NUM_IMAGE_TOKEN_TYPES,
+    image_token_id,
+    preprocess_image,
+)
+from .routing import (
+    sanitize_synthetic_image_token_ids,
+    synthetic_image_token_mask,
+)
+from .vision import DeepseekV4VisionAligner, DeepseekV4VisionTransformer
+
+
+class DeepseekV4VisionProcessingInfo(BaseProcessingInfo):
+    def __init__(self, ctx: InputProcessingContext) -> None:
+        super().__init__(ctx)
+        self.hf_config = self.get_hf_config()
+        tokenizer = self.get_tokenizer()
+        placeholder_id = tokenizer.convert_tokens_to_ids(IMAGE_PLACEHOLDER)
+        if not isinstance(placeholder_id, int) or placeholder_id < 0:
+            raise ValueError(f"Tokenizer does not define {IMAGE_PLACEHOLDER!r}")
+        self.placeholder_id = placeholder_id
+
+    def get_hf_config(self) -> DeepseekV4Config:
+        return self.ctx.get_hf_config(DeepseekV4Config)
+
+    def get_supported_mm_limits(self) -> Mapping[str, int | None]:
+        if self.hf_config.vision_n_layers is None:
+            return {"image": 0}
+        return {"image": None}
+
+
+class DeepseekV4VisionDummyInputsBuilder(
+    BaseDummyInputsBuilder[DeepseekV4VisionProcessingInfo]
+):
+    def get_dummy_text(self, mm_counts: Mapping[str, int]) -> str:
+        return IMAGE_PLACEHOLDER * mm_counts.get("image", 0)
+
+    def get_dummy_mm_data(
+        self,
+        seq_len: int,
+        mm_counts: Mapping[str, int],
+        mm_options: Mapping[str, BaseDummyOptions] | None = None,
+    ) -> MultiModalDataDict:
+        del seq_len
+        config = self.info.hf_config
+        side = (
+            int(config.vision_patch_size)
+            * int(config.vision_downsample_ratio)
+            * 18
+        )
+        return {
+            "image": self._get_dummy_images(
+                width=side,
+                height=side,
+                num_images=mm_counts.get("image", 0),
+                overrides=mm_options.get("image") if mm_options else None,
+            )
+        }
+
+
+class DeepseekV4VisionMultiModalProcessor(
+    BaseMultiModalProcessor[DeepseekV4VisionProcessingInfo]
+):
+    def _call_hf_processor(
+        self,
+        prompt: str,
+        mm_data: Mapping[str, object],
+        mm_kwargs: Mapping[str, object],
+        tok_kwargs: Mapping[str, object],
+    ) -> BatchFeature:
+        del mm_kwargs
+        tokenizer = self.info.get_tokenizer()
+        prompt_ids = tokenizer.encode(prompt, **tok_kwargs)
+        raw_images = mm_data.get("images", mm_data.get("image", []))
+        if raw_images is None:
+            raw_images = []
+        images = (
+            list(raw_images)
+            if isinstance(raw_images, (list, tuple))
+            else [raw_images]
+        )
+        if not images:
+            return BatchFeature({"input_ids": [prompt_ids]})
+
+        expanded_ids: list[int] = []
+        processed = []
+        image_index = 0
+        for token_id in prompt_ids:
+            if token_id != self.info.placeholder_id:
+                expanded_ids.append(token_id)
+                continue
+            if image_index >= len(images):
+                raise ValueError(
+                    "DeepSeek prompt has more image placeholders than images"
+                )
+            item = preprocess_image(
+                images[image_index],
+                self.info.hf_config,
+                start_position=len(expanded_ids),
+            )
+            synthetic_ids = (
+                int(self.info.hf_config.vocab_size) + item.token_types
+            )
+            expanded_ids.extend(synthetic_ids.tolist())
+            processed.append((item, synthetic_ids))
+            image_index += 1
+        if image_index != len(images):
+            raise ValueError("DeepSeek prompt has fewer image placeholders than images")
+
+        return BatchFeature(
+            {
+                "input_ids": [expanded_ids],
+                "pixel_values": torch.cat([item.patches for item, _ in processed]),
+                "n_vit_h": torch.tensor(
+                    [item.n_vit_h for item, _ in processed], dtype=torch.int64
+                ),
+                "n_vit_w": torch.tensor(
+                    [item.n_vit_w for item, _ in processed], dtype=torch.int64
+                ),
+                "image_perm": torch.cat(
+                    [item.feature_permutation for item, _ in processed]
+                ),
+                "image_token_ids": torch.cat(
+                    [synthetic_ids for _, synthetic_ids in processed]
+                ),
+            }
+        )
+
+    def _hf_processor_applies_updates(
+        self,
+        prompt_text: str,
+        mm_items: MultiModalDataItems,
+        hf_processor_mm_kwargs: Mapping[str, object],
+        tokenization_kwargs: Mapping[str, object],
+    ) -> bool:
+        del prompt_text, mm_items, hf_processor_mm_kwargs, tokenization_kwargs
+        return True
+
+    def _cached_apply_hf_processor(
+        self,
+        inputs: ProcessorInputs,
+        timing_ctx: TimingContext,
+    ):
+        # N-layout alignment depends on each placeholder's absolute token offset.
+        return self._apply_hf_processor(inputs, timing_ctx)
+
+    def _get_mm_fields_config(
+        self,
+        hf_inputs: BatchFeature,
+        hf_processor_mm_kwargs: Mapping[str, object],
+    ) -> Mapping[str, MultiModalFieldConfig]:
+        del hf_processor_mm_kwargs
+        n_vit_h = hf_inputs.get("n_vit_h", torch.empty(0, dtype=torch.int64))
+        n_vit_w = hf_inputs.get("n_vit_w", torch.empty(0, dtype=torch.int64))
+        patch_counts = n_vit_h * n_vit_w
+        ratio = int(self.info.hf_config.vision_downsample_ratio)
+        feature_counts = torch.div(
+            n_vit_h + ratio - 1, ratio, rounding_mode="floor"
+        ) * torch.div(n_vit_w + ratio - 1, ratio, rounding_mode="floor")
+        token_ids = hf_inputs.get("image_token_ids", torch.empty(0, dtype=torch.int64))
+        if n_vit_h.numel() == 0:
+            token_counts = torch.empty(0, dtype=torch.int64)
+        else:
+            end_id = image_token_id(int(self.info.hf_config.vocab_size), IMAGE_END)
+            end_offsets = torch.nonzero(token_ids == end_id).flatten()
+            starts = torch.cat((end_offsets.new_tensor([-1]), end_offsets[:-1])) + 1
+            token_counts = end_offsets - starts + 1
+
+        return {
+            "pixel_values": MultiModalFieldConfig.flat_from_sizes(
+                "image", patch_counts
+            ),
+            "n_vit_h": MultiModalFieldConfig.batched("image", keep_on_cpu=True),
+            "n_vit_w": MultiModalFieldConfig.batched("image", keep_on_cpu=True),
+            "image_perm": MultiModalFieldConfig.flat_from_sizes(
+                "image", feature_counts
+            ),
+            "image_token_ids": MultiModalFieldConfig.flat_from_sizes(
+                "image", token_counts
+            ),
+        }
+
+    def _get_prompt_updates(
+        self,
+        mm_items: MultiModalDataItems,
+        hf_processor_mm_kwargs: Mapping[str, Any],
+        out_mm_kwargs: MultiModalKwargsItems,
+    ) -> Sequence[PromptUpdate]:
+        del mm_items, hf_processor_mm_kwargs
+        image_feature_id = image_token_id(
+            int(self.info.hf_config.vocab_size), IMAGE
+        )
+
+        def replacement(item_idx: int) -> PromptUpdateDetails[list[int]]:
+            token_ids = out_mm_kwargs["image"][item_idx]["image_token_ids"].data
+            return PromptUpdateDetails.select_token_id(
+                token_ids.tolist(), image_feature_id
+            )
+
+        return [
+            PromptReplacement(
+                modality="image",
+                target=[self.info.placeholder_id],
+                replacement=replacement,
+            )
+        ]
+
+
+def wrap_deepseek_v4_multimodal(base_model_cls: type[nn.Module]) -> type[nn.Module]:
+    @MULTIMODAL_REGISTRY.register_processor(
+        DeepseekV4VisionMultiModalProcessor,
+        info=DeepseekV4VisionProcessingInfo,
+        dummy_inputs=DeepseekV4VisionDummyInputsBuilder,
+    )
+    class DeepseekV4ForCausalLM(base_model_cls, SupportsMultiModal):
+        supports_multimodal = True
+        supports_multimodal_embeddings = True
+        requires_raw_input_tokens = True
+
+        @classmethod
+        def get_placeholder_str(cls, modality: str, i: int) -> str | None:
+            del i
+            if modality == "image":
+                return IMAGE_PLACEHOLDER
+            raise ValueError(f"Unsupported DeepSeek V4 modality: {modality}")
+
+        def get_language_model(self):
+            # The wrapper itself owns the base model's `.model` attribute.
+            # Returning the inner DeepseekV4Model would break SupportsEagle3,
+            # which expects the language model object to expose `.model`.
+            return self
+
+        def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+            super().__init__(vllm_config=vllm_config, prefix=prefix)
+            config = vllm_config.model_config.hf_config
+            self._vision_enabled = config.vision_n_layers is not None
+            if not self._vision_enabled:
+                return
+
+            with self._mark_tower_model(vllm_config, "image"):
+                self.vision = DeepseekV4VisionTransformer(config)
+                self.aligner = DeepseekV4VisionAligner(config)
+                hidden_size = int(config.hidden_size)
+                self.image_start = nn.Parameter(torch.empty(hidden_size))
+                self.image_pad = nn.Parameter(torch.empty(hidden_size))
+                self.image_newline = nn.Parameter(torch.empty(hidden_size))
+                self.image_end = nn.Parameter(torch.empty(hidden_size))
+            self.configure_mm_token_handling(
+                int(config.vocab_size),
+                [
+                    image_token_id(int(config.vocab_size), token_type)
+                    for token_type in range(NUM_IMAGE_TOKEN_TYPES)
+                ],
+            )
+
+        def embed_multimodal(
+            self,
+            pixel_values: torch.Tensor,
+            n_vit_h: torch.Tensor,
+            n_vit_w: torch.Tensor,
+            image_perm: torch.Tensor,
+            image_token_ids: torch.Tensor | None = None,
+            **_: object,
+        ) -> MultiModalEmbeddings:
+            del image_token_ids
+            if not self._vision_enabled:
+                raise ValueError("This DeepSeek V4 checkpoint has no vision tower")
+
+            heights = [int(value) for value in n_vit_h.reshape(-1).tolist()]
+            widths = [int(value) for value in n_vit_w.reshape(-1).tolist()]
+            patch_counts = [height * width for height, width in zip(heights, widths)]
+            ratio = int(self.config.vision_downsample_ratio)
+            feature_counts = [
+                ((height + ratio - 1) // ratio)
+                * ((width + ratio - 1) // ratio)
+                for height, width in zip(heights, widths)
+            ]
+            patch_items = pixel_values.split(patch_counts)
+            perm_items = image_perm.split(feature_counts)
+
+            outputs: list[torch.Tensor] = []
+            for patches, height, width, permutation in zip(
+                patch_items, heights, widths, perm_items
+            ):
+                encoded = self.vision(patches, height, width)
+                aligned = self.aligner(encoded, height, width)
+                outputs.append(aligned[permutation.to(aligned.device, torch.long)])
+            return outputs
+
+        def embed_input_ids(
+            self,
+            input_ids: torch.Tensor,
+            multimodal_embeddings: MultiModalEmbeddings | None = None,
+            *,
+            is_multimodal: torch.Tensor | None = None,
+        ) -> torch.Tensor:
+            if not self._vision_enabled:
+                return self.model.embed_input_ids(input_ids)
+
+            vocab_size = int(self.config.vocab_size)
+            safe_ids = sanitize_synthetic_image_token_ids(input_ids, vocab_size)
+            embeddings = self.model.embed_input_ids(safe_ids)
+            synthetic_mask = synthetic_image_token_mask(input_ids, vocab_size)
+            token_types = (input_ids - vocab_size).clamp(
+                min=0, max=NUM_IMAGE_TOKEN_TYPES - 1
+            )
+            special = torch.stack(
+                (
+                    self.image_start,
+                    self.image_pad,
+                    torch.zeros_like(self.image_start),
+                    self.image_newline,
+                    self.image_end,
+                )
+            ).to(embeddings.dtype)
+            special_embeddings = special[token_types]
+            embeddings = torch.where(
+                synthetic_mask.unsqueeze(-1), special_embeddings, embeddings
+            )
+
+            if multimodal_embeddings is None or len(multimodal_embeddings) == 0:
+                return embeddings
+            if is_multimodal is None:
+                raise ValueError("DeepSeek V4 image features require an embedding mask")
+            return _merge_multimodal_embeddings(
+                inputs_embeds=embeddings,
+                multimodal_embeddings=multimodal_embeddings,
+                is_multimodal=is_multimodal,
+            )
+
+        def load_weights(
+            self, weights: Iterable[tuple[str, torch.Tensor]]
+        ) -> set[str]:
+            loaded = super().load_weights(weights)
+            if self._vision_enabled:
+                required = {
+                    name
+                    for name, _ in self.named_parameters()
+                    if name.startswith(("vision.", "aligner.", "image_"))
+                }
+                missing = required - loaded
+                if missing:
+                    preview = ", ".join(sorted(missing)[:8])
+                    raise ValueError(
+                        "DeepSeek V4 Vision checkpoint is missing required weights: "
+                        f"{preview}"
+                    )
+            return loaded
+
+    DeepseekV4ForCausalLM.__module__ = "vllm.models.deepseek_v4"
+    DeepseekV4ForCausalLM.__qualname__ = "DeepseekV4ForCausalLM"
+    return DeepseekV4ForCausalLM
