diff --git a/vllm/models/deepseek_v4/routing.py b/vllm/models/deepseek_v4/routing.py
new file mode 100644
index 0000000..9487bc1
--- /dev/null
+++ b/vllm/models/deepseek_v4/routing.py
@@ -0,0 +1,196 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Vision-aware DeepSeek V4 MoE routing and synthetic-token safety."""
+
+import torch
+import torch.nn.functional as F
+
+from vllm.model_executor.layers.fused_moe.router.fused_topk_bias_router import (
+    FusedTopKBiasRouter,
+)
+
+from .image_processing import NUM_IMAGE_TOKEN_TYPES
+
+
+def synthetic_image_token_mask(
+    input_ids: torch.Tensor,
+    vocab_size: int,
+) -> torch.Tensor:
+    return (input_ids >= vocab_size) & (
+        input_ids < vocab_size + NUM_IMAGE_TOKEN_TYPES
+    )
+
+
+def sanitize_synthetic_image_token_ids(
+    input_ids: torch.Tensor,
+    vocab_size: int,
+) -> torch.Tensor:
+    """Map only the five legal synthetic image IDs to text token zero."""
+    return torch.where(
+        synthetic_image_token_mask(input_ids, vocab_size),
+        torch.zeros_like(input_ids),
+        input_ids,
+    )
+
+
+def vision_aware_topk(
+    *,
+    gating_output: torch.Tensor,
+    input_ids: torch.Tensor,
+    vocab_size: int,
+    topk: int,
+    scoring_func: str,
+    text_bias: torch.Tensor | None,
+    vision_bias: torch.Tensor,
+    hash_indices_table: torch.Tensor | None,
+    renormalize: bool,
+    routed_scaling_factor: float,
+    indices_type: torch.dtype | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Select experts while preserving text hash/score routing exactly."""
+    if input_ids is None:
+        raise ValueError("DeepSeek V4 Vision MoE routing requires raw input_ids")
+
+    flat_ids = input_ids.reshape(-1)
+    router_logits = gating_output.reshape(flat_ids.shape[0], -1)
+    if scoring_func == "softmax":
+        scores = router_logits.softmax(dim=-1)
+    elif scoring_func == "sigmoid":
+        scores = router_logits.sigmoid()
+    elif scoring_func == "sqrtsoftplus":
+        scores = F.softplus(router_logits).sqrt()
+    else:
+        raise ValueError(f"Unsupported DeepSeek V4 routing score: {scoring_func}")
+
+    image_mask = synthetic_image_token_mask(flat_ids, vocab_size)
+    safe_ids = torch.where(image_mask, torch.zeros_like(flat_ids), flat_ids)
+    if hash_indices_table is not None:
+        if safe_ids.dtype != hash_indices_table.dtype:
+            safe_ids = safe_ids.to(hash_indices_table.dtype)
+        text_indices = hash_indices_table[safe_ids]
+        vision_indices = torch.topk(
+            scores + vision_bias.unsqueeze(0),
+            k=topk,
+            dim=-1,
+            sorted=False,
+        ).indices
+        topk_indices = torch.where(
+            image_mask.unsqueeze(-1),
+            vision_indices.to(text_indices.dtype),
+            text_indices,
+        )
+    else:
+        if text_bias is None:
+            raise ValueError("DeepSeek V4 score routing requires its text bias")
+        choice_bias = torch.where(
+            image_mask.unsqueeze(-1),
+            vision_bias.unsqueeze(0),
+            text_bias.unsqueeze(0),
+        )
+        topk_indices = torch.topk(
+            scores + choice_bias,
+            k=topk,
+            dim=-1,
+            sorted=False,
+        ).indices
+
+    topk_weights = scores.gather(1, topk_indices.to(torch.int64))
+    if renormalize:
+        topk_weights /= topk_weights.sum(dim=-1, keepdim=True)
+    topk_weights = topk_weights.to(torch.float32)
+    if routed_scaling_factor != 1.0:
+        topk_weights *= routed_scaling_factor
+    target_dtype = torch.int32 if indices_type is None else indices_type
+    return topk_weights, topk_indices.to(target_dtype)
+
+
+class DeepseekV4VisionRouter(FusedTopKBiasRouter):
+    def __init__(
+        self,
+        *,
+        base_router: FusedTopKBiasRouter,
+        vision_bias: torch.Tensor,
+        vocab_size: int,
+    ) -> None:
+        super().__init__(
+            top_k=base_router.top_k,
+            global_num_experts=base_router.global_num_experts,
+            e_score_correction_bias=base_router.e_score_correction_bias,
+            renormalize=base_router.renormalize,
+            routed_scaling_factor=base_router.routed_scaling_factor,
+            eplb_state=base_router.eplb_state,
+            scoring_func=base_router.scoring_func,
+            hash_indices_table=base_router._hash_indices_table,
+            num_fused_shared_experts=base_router.num_fused_shared_experts,
+            shared_expert_weight=base_router.shared_expert_weight,
+        )
+        self.vision_bias = vision_bias
+        self.vocab_size = vocab_size
+        self.capture_fn = base_router.capture_fn
+
+    def _compute_routing(
+        self,
+        hidden_states: torch.Tensor,
+        router_logits: torch.Tensor,
+        indices_type: torch.dtype | None,
+        *,
+        input_ids: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del hidden_states
+        if input_ids is None:
+            raise ValueError("DeepSeek V4 Vision router requires raw input_ids")
+        topk_weights, topk_ids = vision_aware_topk(
+            gating_output=router_logits,
+            input_ids=input_ids,
+            vocab_size=self.vocab_size,
+            topk=self.top_k,
+            scoring_func=self.scoring_func,
+            text_bias=(
+                self.e_score_correction_bias.data
+                if self.e_score_correction_bias is not None
+                else None
+            ),
+            vision_bias=self.vision_bias,
+            hash_indices_table=self._hash_indices_table,
+            renormalize=self.renormalize,
+            routed_scaling_factor=self.routed_scaling_factor,
+            indices_type=indices_type,
+        )
+
+        if self.num_fused_shared_experts > 0:
+            rows = topk_ids.shape[0]
+            count = self.num_fused_shared_experts
+            base = self.global_num_experts
+            shared_ids = torch.arange(
+                base,
+                base + count,
+                dtype=topk_ids.dtype,
+                device=topk_ids.device,
+            ).expand(rows, count)
+            shared_weights = torch.full(
+                (rows, count),
+                self.shared_expert_weight,
+                dtype=topk_weights.dtype,
+                device=topk_weights.device,
+            )
+            topk_ids = torch.cat((topk_ids, shared_ids), dim=-1)
+            topk_weights = torch.cat((topk_weights, shared_weights), dim=-1)
+        return topk_weights, topk_ids
+
+
+def install_vision_router(
+    moe_runner,
+    vision_bias: torch.Tensor,
+    vocab_size: int,
+) -> None:
+    base_router = moe_runner.router
+    if not isinstance(base_router, FusedTopKBiasRouter):
+        raise TypeError(
+            "DeepSeek V4 Vision requires the modular FusedTopKBiasRouter; "
+            f"got {type(base_router).__name__}"
+        )
+    moe_runner.router = DeepseekV4VisionRouter(
+        base_router=base_router,
+        vision_bias=vision_bias,
+        vocab_size=vocab_size,
+    )
