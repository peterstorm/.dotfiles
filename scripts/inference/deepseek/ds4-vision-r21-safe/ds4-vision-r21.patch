index 0000000..ddbb6e6
--- /dev/null
+++ b/vllm/models/deepseek_v4/image_processing.py
@@ -0,0 +1,248 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Checkpoint-compatible DeepSeek V4 Vision image preprocessing."""
+
+import math
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+from PIL import Image, ImageOps
+
+IMAGE_START = 0
+IMAGE_PAD = 1
+IMAGE = 2
+IMAGE_NEWLINE = 3
+IMAGE_END = 4
+NUM_IMAGE_TOKEN_TYPES = 5
+IMAGE_PLACEHOLDER = "<｜deepseek_image｜>"
+_COMPRESS_PAD_TO = 4
+
+
+@dataclass(frozen=True)
+class ProcessedImage:
+    patches: torch.Tensor
+    n_vit_h: int
+    n_vit_w: int
+    token_types: torch.Tensor
+    feature_permutation: torch.Tensor
+
+    @property
+    def token_count(self) -> int:
+        return int(self.token_types.numel())
+
+    @property
+    def feature_count(self) -> int:
+        return int(self.feature_permutation.numel())
+
+
+def image_token_id(vocab_size: int, token_type: int) -> int:
+    if not 0 <= token_type < NUM_IMAGE_TOKEN_TYPES:
+        raise ValueError(f"Invalid DeepSeek image token type: {token_type}")
+    return vocab_size + token_type
+
+
+def is_synthetic_image_token_id(token_id: int, vocab_size: int) -> bool:
+    return vocab_size <= token_id < vocab_size + NUM_IMAGE_TOKEN_TYPES
+
+
+def _grid_tokens(
+    height: int,
+    width: int,
+    patch_size: int,
+    downsample_ratio: int,
+) -> tuple[int, int, int]:
+    n_llm_h = math.ceil((height // patch_size) / downsample_ratio)
+    n_llm_w = math.ceil((width // patch_size) / downsample_ratio)
+    num_tokens = n_llm_h * (n_llm_w + 1) + 2
+    if n_llm_h % 2 == 1:
+        num_tokens += n_llm_w + 1
+    num_tokens += (n_llm_h + 1) // 2 * (n_llm_w + 1) % 2 * 2
+    return n_llm_h, n_llm_w, num_tokens
+
+
+def _solve_resize_ratio(
+    height: int,
+    width: int,
+    patch_size: int,
+    downsample_ratio: int,
+    max_tokens: int,
+) -> tuple[int, int, int, int, int]:
+    aspect_ratio = height / width
+    max_w_float = math.sqrt((max_tokens - 2) / aspect_ratio + 0.25) - 0.5
+    max_h_float = max_w_float * aspect_ratio
+    if max_w_float < 1.0:
+        max_w = 1
+        max_h = (max_tokens - 2) // (max_w + 1)
+        if max_h % 2 == 1:
+            max_h -= 1
+        best_width = max_w * patch_size * downsample_ratio
+        best_height = max_h * patch_size * downsample_ratio
+    elif max_h_float < 2.0:
+        max_h = 2
+        max_w = (max_tokens - 2) // max_h - 1
+        if max_w <= 1:
+            raise ValueError("DeepSeek image token budget cannot represent this image")
+        best_width = max_w * patch_size * downsample_ratio
+        best_height = max_h * patch_size * downsample_ratio
+    else:
+        max_w = math.floor(max_w_float)
+        max_h = math.floor(max_h_float)
+        if max_h % 2 == 1:
+            max_h -= 1
+        scale = min(
+            max_w * patch_size * downsample_ratio / width,
+            max_h * patch_size * downsample_ratio / height,
+        )
+        best_width = math.floor(width * scale / patch_size) * patch_size
+        best_height = math.floor(height * scale / patch_size) * patch_size
+
+    n_llm_h, n_llm_w, num_tokens = _grid_tokens(
+        best_height, best_width, patch_size, downsample_ratio
+    )
+    return n_llm_h, n_llm_w, best_height, best_width, num_tokens
+
+
+def _safe_resize(
+    height: int,
+    width: int,
+    best_height: int,
+    best_width: int,
+    patch_size: int,
+    downsample_ratio: int,
+    max_tokens: int,
+) -> tuple[int, int, int, int]:
+    budget = max_tokens - (_COMPRESS_PAD_TO - 1)
+    n_llm_h, n_llm_w, num_tokens = _grid_tokens(
+        best_height, best_width, patch_size, downsample_ratio
+    )
+    while num_tokens > budget:
+        n_llm_h, n_llm_w, best_height, best_width, num_tokens = (
+            _solve_resize_ratio(
+                height,
+                width,
+                patch_size,
+                downsample_ratio,
+                budget,
+            )
+        )
+        budget -= 1
+        if budget <= 2:
+            raise ValueError("DeepSeek image cannot fit its configured token budget")
+    return n_llm_h, n_llm_w, best_height, best_width
+
+
+def build_image_block(
+    n_llm_h: int,
+    n_llm_w: int,
+    start_position: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return official N-layout token types and aligned-feature permutation."""
+    if n_llm_h <= 0 or n_llm_w <= 0:
+        raise ValueError("DeepSeek image grid dimensions must be positive")
+
+    compress_pad = _COMPRESS_PAD_TO - 1 - start_position % _COMPRESS_PAD_TO
+    pad_h = n_llm_h % 2
+    rows = n_llm_h + pad_h
+    row_len = n_llm_w + 1
+    pad_last = rows // 2 * row_len % 2 * 2
+
+    row_types = ([IMAGE] * n_llm_w + [IMAGE_NEWLINE]) * n_llm_h
+    token_types = torch.tensor(
+        row_types + [IMAGE_PAD] * (row_len * pad_h), dtype=torch.int64
+    )
+    order = (
+        torch.arange(rows * row_len)
+        .view(rows // 2, 2, row_len)
+        .transpose(1, 2)
+        .reshape(-1)
+    )
+    image_index = torch.full((rows * row_len,), -1, dtype=torch.int64)
+    image_index.view(rows, row_len)[:n_llm_h, :n_llm_w] = torch.arange(
+        n_llm_h * n_llm_w
+    ).view(n_llm_h, n_llm_w)
+    permutation = image_index[order]
+    permutation = permutation[permutation >= 0]
+
+    token_types = torch.cat(
+        [
+            torch.full((compress_pad,), IMAGE_PAD, dtype=torch.int64),
+            torch.tensor([IMAGE_START]),
+            token_types[order],
+            torch.full((pad_last,), IMAGE_PAD, dtype=torch.int64),
+            torch.tensor([IMAGE_END]),
+        ]
+    )
+    return token_types, permutation
+
+
+def preprocess_image(image: Image.Image, config, start_position: int) -> ProcessedImage:
+    """Convert one PIL image into ViT patches and its position-dependent layout."""
+    patch_size = int(config.vision_patch_size)
+    downsample_ratio = int(config.vision_downsample_ratio)
+    max_tokens = int(config.vision_max_n_token)
+
+    rgb = image.convert("RGB")
+    width, height = rgb.size
+    if width <= 0 or height <= 0:
+        raise ValueError("DeepSeek image dimensions must be positive")
+
+    max_wh_ratio = getattr(config, "vision_max_wh_ratio", None)
+    if max_wh_ratio is not None and width > height * max_wh_ratio:
+        width = int(height * max_wh_ratio)
+
+    min_pixels = int(config.vision_min_pixels)
+    if width * height < min_pixels:
+        scale = math.sqrt(min_pixels / (width * height))
+        width = max(1, int(width * scale))
+        height = max(1, int(height * scale))
+
+    best_width = math.ceil(width / patch_size) * patch_size
+    best_height = math.ceil(height / patch_size) * patch_size
+    n_llm_h, n_llm_w, best_height, best_width = _safe_resize(
+        height,
+        width,
+        best_height,
+        best_width,
+        patch_size,
+        downsample_ratio,
+        max_tokens,
+    )
+    n_vit_h = best_height // patch_size
+    n_vit_w = best_width // patch_size
+
+    if max_wh_ratio is not None and rgb.width >= max_wh_ratio * rgb.height:
+        rgb = rgb.resize((best_width, best_height))
+    else:
+        rgb = ImageOps.pad(
+            rgb,
+            (best_width, best_height),
+            color=(127, 127, 127),
+        )
+
+    pixels = torch.from_numpy(np.asarray(rgb, dtype=np.float32).copy())
+    pixels = pixels.permute(2, 0, 1) / 255.0
+    pixels = ((pixels - 0.5) / 0.5).to(torch.bfloat16)
+    patches = (
+        pixels.reshape(3, n_vit_h, patch_size, n_vit_w, patch_size)
+        .permute(1, 3, 0, 2, 4)
+        .reshape(n_vit_h * n_vit_w, 3, patch_size, patch_size)
+    )
+    token_types, permutation = build_image_block(
+        n_llm_h, n_llm_w, start_position
+    )
+    if token_types.numel() > max_tokens:
+        raise ValueError(
+            f"DeepSeek image layout uses {token_types.numel()} tokens, "
+            f"exceeding vision_max_n_token={max_tokens}"
+        )
+    if permutation.numel() != n_llm_h * n_llm_w:
+        raise RuntimeError("DeepSeek image feature permutation is incomplete")
+
+    return ProcessedImage(
+        patches=patches,
+        n_vit_h=n_vit_h,
+        n_vit_w=n_vit_w,
+        token_types=token_types,
+        feature_permutation=permutation,
+    )
diff --git a/vllm/models/deepseek_v4/multimodal.py b/vllm/models/deepseek_v4/multimodal.py
