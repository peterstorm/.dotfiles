+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Image-visible sparse-window metadata and exact LSE partition merging."""
+
+import torch
+
+from .image_processing import (
+    IMAGE_END,
+    IMAGE_PAD,
+    IMAGE_START,
+    NUM_IMAGE_TOKEN_TYPES,
+    image_token_id,
+)
+
+
+def _image_spans(token_ids: list[int], vocab_size: int) -> list[tuple[int, int]]:
+    start_id = image_token_id(vocab_size, IMAGE_START)
+    end_id = image_token_id(vocab_size, IMAGE_END)
+    spans: list[tuple[int, int]] = []
+    open_start: int | None = None
+    for index, token_id in enumerate(token_ids):
+        is_synthetic = vocab_size <= token_id < vocab_size + NUM_IMAGE_TOKEN_TYPES
+        if token_id == start_id:
+            if open_start is not None:
+                raise ValueError("Nested DeepSeek image spans are not supported")
+            open_start = index
+        elif token_id == end_id:
+            if open_start is None:
+                raise ValueError("DeepSeek image span ends outside its prefill chunk")
+            spans.append((open_start, index))
+            open_start = None
+        elif is_synthetic and open_start is None and token_id != image_token_id(
+            vocab_size, IMAGE_PAD
+        ):
+            raise ValueError("DeepSeek image span is split across prefill chunks")
+    if open_start is not None:
+        raise ValueError("DeepSeek image span is split across prefill chunks")
+    return spans
+
+
+def build_image_partition_indices(
+    *,
+    input_ids: torch.Tensor,
+    positions: torch.Tensor,
+    query_start_loc_cpu: torch.Tensor,
+    block_table: torch.Tensor,
+    block_size: int,
+    num_decodes: int,
+    num_decode_tokens: int,
+    window_size: int,
+    max_image_tokens: int,
+    output_indices: torch.Tensor,
+    output_lens: torch.Tensor,
+    vocab_size: int,
+) -> bool:
+    """Build paged indices disjoint from ordinary causal SWA for image rows."""
+    output_indices.fill_(-1)
+    output_lens.zero_()
+    has_image_rows = False
+
+    for req_index in range(num_decodes, query_start_loc_cpu.numel() - 1):
+        query_start = int(query_start_loc_cpu[req_index].item())
+        query_end = int(query_start_loc_cpu[req_index + 1].item())
+        request_ids = input_ids[query_start:query_end].detach().cpu().tolist()
+        spans = _image_spans(request_ids, vocab_size)
+        if not spans:
+            continue
+
+        request_positions = positions[query_start:query_end]
+        for local_start, local_end in spans:
+            span_length = local_end - local_start + 1
+            if span_length > max_image_tokens:
+                raise ValueError(
+                    f"DeepSeek image span has {span_length} tokens, exceeding "
+                    f"vision_max_n_token={max_image_tokens}"
+                )
+            image_start_pos = int(request_positions[local_start].item())
+            image_end_pos = int(request_positions[local_end].item())
+            if image_end_pos - image_start_pos + 1 != span_length:
+                raise ValueError("DeepSeek image span positions are not contiguous")
+
+            for local_row in range(local_start, local_end + 1):
+                logical_pos = int(request_positions[local_row].item())
+                normal_start = max(logical_pos - window_size + 1, 0)
+                required_start = min(normal_start, image_start_pos)
+                extra_positions = list(range(required_start, normal_start))
+                extra_positions.extend(range(logical_pos + 1, image_end_pos + 1))
+                if not extra_positions:
+                    continue
+                if len(extra_positions) > output_indices.shape[-1]:
+                    raise ValueError(
+                        "DeepSeek image-visible sparse index buffer is too narrow: "
+                        f"need {len(extra_positions)}, have {output_indices.shape[-1]}"
+                    )
+
+                logical = torch.tensor(
+                    extra_positions,
+                    dtype=torch.long,
+                    device=block_table.device,
+                )
+                block_numbers = block_table[
+                    req_index,
+                    torch.div(logical, block_size, rounding_mode="floor"),
+                ].to(torch.long)
+                slots = block_numbers * block_size + logical % block_size
+                output_row = query_start + local_row - num_decode_tokens
+                output_indices[output_row, 0, : slots.numel()].copy_(
+                    slots.to(output_indices.dtype)
+                )
+                output_lens[output_row] = slots.numel()
+                has_image_rows = True
+
+    return has_image_rows
+
+
+def merge_attention_partitions(
+    normal_output: torch.Tensor,
+    normal_lse: torch.Tensor,
+    image_output: torch.Tensor,
+    image_lse: torch.Tensor,
+) -> torch.Tensor:
+    """Merge disjoint natural-log attention partitions exactly."""
+    merged_lse = torch.logaddexp(normal_lse, image_lse)
+    normal_weight = torch.exp(normal_lse - merged_lse)
+    image_weight = torch.exp(image_lse - merged_lse)
+    while normal_weight.ndim < normal_output.ndim:
+        normal_weight = normal_weight.unsqueeze(-1)
+        image_weight = image_weight.unsqueeze(-1)
+    return normal_output * normal_weight + image_output * image_weight
