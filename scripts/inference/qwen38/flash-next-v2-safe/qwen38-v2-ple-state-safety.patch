+@pytest.mark.parametrize("accepted_count", [0, 5])
+def test_dilated_ple_spec_state_rejects_invalid_accepted_count(
+    accepted_count: int,
+) -> None:
+    module = Qwen4ExpPLELayer.__new__(Qwen4ExpPLELayer)
+    nn.Module.__init__(module)
+    module.conv_state_len = 6
+    module.short_conv_dilation = 2
+
+    conv_weights = torch.tensor([[0.25, -0.5, 0.75, 1.0]])
+    conv_state = torch.zeros(2, 1, 9)
+    conv_state[1] = torch.arange(1, 10, dtype=torch.float32).reshape(1, 9)
+    state_before = conv_state.clone()
+
+    output = module._short_conv_dilated_spec_batched(
+        torch.tensor([[10.0], [20.0], [30.0], [40.0]]),
+        conv_state,
+        conv_weights,
+        torch.tensor([1]),
+        torch.tensor([0, 4]),
+        torch.tensor([accepted_count]),
+        spec_query_len=4,
+    )
+
+    torch.testing.assert_close(output, torch.zeros_like(output))
+    torch.testing.assert_close(conv_state, state_before)
+
+
