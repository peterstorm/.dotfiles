+@pytest.mark.parametrize("state_index", [-1, 2])
+def test_dilated_ple_decode_rejects_out_of_range_state_index(
+    state_index: int,
+) -> None:
+    module = Qwen4ExpPLELayer.__new__(Qwen4ExpPLELayer)
+    nn.Module.__init__(module)
+    module.conv_state_len = 6
+    module.short_conv_dilation = 2
+
+    conv_state = torch.zeros(2, 1, 6)
+    state_before = conv_state.clone()
+    output = module._short_conv_dilated_decode_batched(
+        torch.tensor([[10.0]]),
+        conv_state,
+        torch.tensor([[0.25, -0.5, 0.75, 1.0]]),
+        torch.tensor([state_index]),
+        None,
+    )
+
+    torch.testing.assert_close(output, torch.zeros_like(output))
+    torch.testing.assert_close(conv_state, state_before)
+
+
