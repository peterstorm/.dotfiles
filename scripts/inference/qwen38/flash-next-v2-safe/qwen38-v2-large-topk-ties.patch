+  // -- Stage 3b: Select exact-score boundary ties by global token index --
+  // Each CTA owns one contiguous token range. Publish equal counts, then use
+  // the counts of lower CTA ids as a stable global prefix. A block scan gives
+  // equal elements within this chunk deterministic index order. This removes
+  // the cross-CTA atomic race that otherwise chooses an arbitrary subset when
+  // more boundary-equal elements exist than the remaining top-k capacity.
+  uint32_t* equal_counts = state->histogram[(radix_iter * 4 + 2) % 3];
+  if (tx == 0) equal_counts[cta_in_group] = local_eq_count;
+  if (tx == 0) red_release(&state->arrival_counter, 1);
+  wait_ge(&state->arrival_counter,
+          (barrier_phase + 1) * static_cast<int>(ctas_per_group), tx);
+  barrier_phase++;
+
+  if (tx == 0) {
+    uint32_t equal_before = 0;
+    for (uint32_t cta = 0; cta < cta_in_group; ++cta) {
+      equal_before += equal_counts[cta];
+    }
+    shared_scalars[4] = equal_before;
+    suffix_sum[0] = 0;
+  }
+  __syncthreads();
+
+  const uint32_t global_gt_count =
+      static_cast<uint32_t>(state->output_counter);
+  const uint32_t equal_before = shared_scalars[4];
+  const uint32_t lane = tx % 32;
+  const uint32_t warp = tx / 32;
+
+  for (uint32_t base = 0; base < actual_chunk_size;
+       base += kThreadsPerBlock) {
+    const uint32_t i = base + tx;
+    const bool matches =
+        i < actual_chunk_size && shared_ordered[i] == ordered_pivot;
+    const uint32_t match_mask = __ballot_sync(0xffffffff, matches);
+    if (lane == 0) local_histogram[warp] = __popc(match_mask);
+    __syncthreads();
+
+    if (tx < 32) {
+      uint32_t warp_prefix = 0;
+      for (uint32_t prior = 0; prior < tx; ++prior) {
+        warp_prefix += local_histogram[prior];
+      }
+      local_histogram[32 + tx] = warp_prefix;
+      if (tx == 31) {
+        shared_scalars[3] = warp_prefix + local_histogram[31];
       }
     }
+    __syncthreads();
+
+    const uint32_t lower_lane_mask =
+        lane == 0 ? 0u : ((1u << lane) - 1u);
+    const uint32_t rank = local_histogram[32 + warp] +
+                          __popc(match_mask & lower_lane_mask);
+    const uint32_t local_base = suffix_sum[0];
+    const uint32_t output_pos =
+        global_gt_count + equal_before + local_base + rank;
+    if (matches && output_pos < TopK) {
+      row_output[output_pos] = static_cast<int32_t>(my_chunk_start + i);
+    }
+    __syncthreads();
+    if (tx == 0) suffix_sum[0] = local_base + shared_scalars[3];
+    __syncthreads();
   }
+
+  // Keep the count buffer live until every CTA has consumed its prefix before
+  // the next persistent row reuses the triple-buffered histogram storage.
+  if (tx == 0) red_release(&state->arrival_counter, 1);
+  wait_ge(&state->arrival_counter,
+          (barrier_phase + 1) * static_cast<int>(ctas_per_group), tx);
+  barrier_phase++;
 }
 
