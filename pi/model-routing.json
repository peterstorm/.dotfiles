{
  "schemaVersion": 1,
  "defaultClass": "cloud",
  "modelClasses": {
    "local": [
      "desktop-vllm/*",
      "llama.cpp/*"
    ]
  },
  "targets": {
    "served": {
      "served": "desktop-vllm"
    },
    "served-high": {
      "served": "desktop-vllm",
      "thinkingLevel": "high"
    }
  },
  "rules": [
    {
      "id": "local-desktop-children-use-served",
      "when": {
        "parentClass": "local",
        "parentModel": "desktop-vllm/*"
      },
      "use": {
        "kind": "named",
        "target": "served"
      }
    },
    {
      "id": "other-local-children-inherit-parent",
      "when": {
        "parentClass": "local"
      },
      "use": {
        "kind": "parent"
      }
    },
    {
      "id": "cloud-workers-use-parent",
      "when": {
        "parentClass": "cloud",
        "workload": "subagent",
        "agent": "worker"
      },
      "use": {
        "kind": "parent"
      }
    },
    {
      "id": "cloud-children-use-served",
      "when": {
        "parentClass": "cloud"
      },
      "use": {
        "kind": "named",
        "target": "served-high"
      }
    }
  ]
}
