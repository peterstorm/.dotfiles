{
  "schemaVersion": 1,
  "defaultClass": "cloud",
  "modelClasses": {
    "local": [
      "desktop-vllm/*",
      "llama.cpp/*"
    ]
  },
  "targets": {
    "sol": {
      "model": "openai-codex/gpt-5.6-sol",
      "thinkingLevel": "high"
    }
  },
  "rules": [
    {
      "id": "sol-subagents-use-high",
      "when": {
        "parentClass": "cloud",
        "parentModel": "openai-codex/gpt-5.6-sol"
      },
      "use": {
        "kind": "named",
        "target": "sol"
      }
    },
    {
      "id": "cloud-workers-use-parent",
      "when": {
        "parentClass": "cloud",
        "workload": "subagent",
        "agent": "worker"
      },
      "use": {
        "kind": "parent"
      }
    },
    {
      "id": "local-workloads-use-parent",
      "when": {
        "parentClass": "local"
      },
      "use": {
        "kind": "parent"
      }
    }
  ]
}
