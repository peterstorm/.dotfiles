{
  "schemaVersion": 1,
  "defaultClass": "cloud",
  "modelClasses": {
    "local": [
      "desktop-vllm/*",
      "desktop-muse/*"
    ]
  },
  "targets": {
    "ds4-vision-r21": {
      "model": "desktop-vllm/deepseek-v4-flash-vision",
      "thinkingLevel": "max"
    },
    "qwen": {
      "model": "desktop-vllm/qwen3.8-27b",
      "thinkingLevel": "xhigh"
    },
    "glm": {
      "model": "desktop-vllm/glm-5.3-flash-exl3-k4-vision-fp8kv-mtp-359k-v8",
      "thinkingLevel": "max"
    },
    "glm-v10-dcp2": {
      "model": "desktop-vllm/glm-5.3-flash-exl3-k4-vision-fp8kv-mtp-359k-v10",
      "thinkingLevel": "max"
    },
    "sol": {
      "model": "openai-codex/gpt-5.6-sol",
      "thinkingLevel": "high"
    }
  },
  "rules": [
    {
      "id": "ds4-vision-r21-subagents-use-max",
      "when": {
        "parentClass": "local",
        "parentModel": "desktop-vllm/deepseek-v4-flash-vision"
      },
      "use": {
        "kind": "named",
        "target": "ds4-vision-r21"
      }
    },
    {
      "id": "glm-v8-subagents-use-max",
      "when": {
        "parentClass": "local",
        "parentModel": "desktop-vllm/glm-5.3-flash-exl3-k4-vision-fp8kv-mtp-359k-v8"
      },
      "use": {
        "kind": "named",
        "target": "glm"
      }
    },
    {
      "id": "glm-v10-dcp2-subagents-use-max",
      "when": {
        "parentClass": "local",
        "parentModel": "desktop-vllm/glm-5.3-flash-exl3-k4-vision-fp8kv-mtp-359k-v10"
      },
      "use": {
        "kind": "named",
        "target": "glm-v10-dcp2"
      }
    },
    {
      "id": "sol-subagents-use-high",
      "when": {
        "parentClass": "cloud",
        "parentModel": "openai-codex/gpt-5.6-sol"
      },
      "use": {
        "kind": "named",
        "target": "sol"
      }
    },
    {
      "id": "local-workloads-use-parent",
      "when": {
        "parentClass": "local"
      },
      "use": {
        "kind": "parent"
      }
    }
  ]
}
