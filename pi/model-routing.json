{
  "schemaVersion": 1,
  "defaultClass": "cloud",
  "modelClasses": {
    "local": [
      "desktop-vllm/*",
      "llama.cpp/*"
    ]
  },
  "targets": {},
  "rules": [
    {
      "id": "local-children-inherit-parent",
      "when": {
        "parentClass": "local"
      },
      "use": {
        "kind": "parent"
      }
    },
    {
      "id": "cloud-workers-use-parent",
      "when": {
        "parentClass": "cloud",
        "workload": "subagent",
        "agent": "worker"
      },
      "use": {
        "kind": "parent"
      }
    }
  ]
}
