{
  "schemaVersion": 1,
  "defaultClass": "cloud",
  "modelClasses": {
    "local": [
      "desktop-vllm/*",
      "desktop-muse/*"
    ]
  },
  "targets": {
    "qwen": {
      "model": "desktop-vllm/qwen3.8-27b",
      "thinkingLevel": "xhigh"
    },
    "glm": {
      "model": "desktop-vllm/glm-5.3-flash-exl3-k4-vision-mtp-384k",
      "thinkingLevel": "max"
    }
  },
  "rules": [
    {
      "id": "local-workloads-use-parent",
      "when": {
        "parentClass": "local"
      },
      "use": {
        "kind": "parent"
      }
    }
  ]
}
