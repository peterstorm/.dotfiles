+/**
+ * Pure precedence rule for the thinking level applied when switching models.
+ * Explicit scoped level, then the user's per-model setting, then a level the user pinned this
+ * session, then the target model's own default (models.json), then the baseline: the global
+ * default, else the current level unless that level only came from the previous model's default.
+ */
+export function resolveThinkingLevelForSwitch(inputs) {
+    if (inputs.scoped !== undefined)
+        return { level: inputs.scoped, source: "scoped" };
+    if (inputs.perModel !== undefined)
+        return { level: inputs.perModel, source: "per-model" };
+    if (inputs.pinned !== undefined)
+        return { level: inputs.pinned, source: "pinned" };
+    if (inputs.modelDefault !== undefined)
+        return { level: inputs.modelDefault, source: "model-default" };
+    const inherited = inputs.currentIsModelDefault ? undefined : inputs.current;
+    return { level: inputs.settingsDefault ?? inherited ?? DEFAULT_THINKING_LEVEL, source: "baseline" };
