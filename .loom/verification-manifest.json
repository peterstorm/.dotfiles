{
  "schemaVersion": 1,
  "kind": "loom-verification-manifest",
  "checks": [
    {
      "id": "project:artex-repair-regression",
      "scope": "wave",
      "executable": "node",
      "args": [
        "--test",
        "--test-reporter=junit",
        "--test-reporter-destination=.loom/completion-reports/artex-repair-regression.xml",
        "tests/artex-repair-regression.test.mjs"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "report": {
        "kind": "required-file",
        "path": ".loom/completion-reports/artex-repair-regression.xml"
      }
    },
    {
      "id": "project:reload-continue-regression",
      "scope": "wave",
      "executable": "bun",
      "args": [
        "test",
        "--reporter",
        "junit",
        "--reporter-outfile",
        ".loom/completion-reports/reload-continue-regression.xml",
        "pi/tests/reload-continue-regression.test.ts"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "report": {
        "kind": "required-file",
        "path": ".loom/completion-reports/reload-continue-regression.xml"
      }
    },
    {
      "id": "project:monitor-regression",
      "scope": "wave",
      "executable": "bun",
      "args": [
        "test",
        "--reporter",
        "junit",
        "--reporter-outfile",
        ".loom/completion-reports/monitor-regression.xml",
        "pi/tests/monitor-regression.test.ts"
      ],
      "cwd": ".",
      "timeoutMs": 120000,
      "report": {
        "kind": "required-file",
        "path": ".loom/completion-reports/monitor-regression.xml"
      }
    }
  ]
}
